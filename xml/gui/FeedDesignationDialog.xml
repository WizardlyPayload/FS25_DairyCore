<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI onOpen="onOpen" onClose="onClose" onCreate="onCreate">
  <GuiElement profile="newLayer"/>
  <Bitmap profile="dialogFullscreenBg" id="dialogBg"/>

  <GuiElement profile="sfDetail_bg" id="dialogElement">
    <ThreePartBitmap profile="fs25_dialogBgMiddle"/>
    <ThreePartBitmap profile="fs25_dialogBgTop"/>
    <ThreePartBitmap profile="fs25_dialogBgBottom"/>

    <GuiElement profile="fs25_dialogContentContainer">
      <Text profile="fs25_dialogTitle" id="fdTitle"
            text="$l10n_dc_fd_title" position="0px -30px"/>

      <Text profile="sfDetail_sectionHeader" id="fdBarnHeader"
            text="$l10n_dc_fd_barn_header" position="0px -70px"/>
      <Text profile="sfDetail_label" id="fdBarnLabel"
            text="" position="0px -98px" size="520px 32px" wrapText="true"/>

      <Text profile="sfDetail_sectionHeader" id="fdFieldHeader"
            text="" position="0px -140px"/>
      <Text profile="sfDetail_label" id="fdFieldState"
            text="" position="0px -168px" size="520px 60px" wrapText="true"/>

      <Text profile="sfDetail_value" id="fdDesignation"
            text="" position="0px -236px" size="520px 24px" wrapText="true"/>

      <Text profile="sfDetail_label" id="fdHint"
            text="$l10n_dc_fd_hint"
            position="0px -272px" size="520px 80px" wrapText="true"/>
    </GuiElement>

    <BoxLayout profile="fs25_dialogButtonBox">
      <Button profile="buttonOK"   id="fdPrevBarnBtn" text="$l10n_dc_fd_prev_barn" onClick="onClickPrevBarn"/>
      <Button profile="buttonOK"   id="fdNextBarnBtn" text="$l10n_dc_fd_next_barn" onClick="onClickNextBarn"/>
      <Button profile="buttonOK"   id="fdPrevFieldBtn" text="$l10n_dc_fd_prev_field" onClick="onClickPrevField"/>
      <Button profile="buttonOK"   id="fdNextFieldBtn" text="$l10n_dc_fd_next_field" onClick="onClickNextField"/>
      <Button profile="buttonOK"   id="fdToggleBtn" text="$l10n_dc_fd_toggle" onClick="onClickToggle"/>
      <Button profile="buttonBack" id="fdBackBtn" text="$l10n_button_back" onClick="onClickBack"/>
    </BoxLayout>
  </GuiElement>
</GUI>
